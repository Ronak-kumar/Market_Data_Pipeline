# =============================================================================
# Market Data Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# Application
APP_ENVIRONMENT=development
APP_DEBUG=true

# Extractor Settings
EXTRACTOR_CLIENT=upstox
EXTRACTOR_INTERVAL=1
EXTRACTOR_MAX_RETRIES=3
EXTRACTOR_EXPIRY_DURATION=3
EXTRACTOR_START_DATE=
EXTRACTOR_END_DATE=

# =============================================================================
# Database Configuration (ClickHouse)
# =============================================================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=market_data
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false
CLICKHOUSE_COMPRESSION=true
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_POOL_MIN=1
CLICKHOUSE_POOL_MAX=10

# PostgreSQL (alternative)
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=market_data
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_POOL_MIN=1
POSTGRESQL_POOL_MAX=10
POSTGRESQL_CONNECT_TIMEOUT=10
POSTGRESQL_SSL_MODE=prefer
POSTGRESQL_APPLICATION_NAME=market_data_pipeline

# TimescaleDB (alternative - inherits PostgreSQL settings)
TIMESCALEDB_CHUNK_TIME_INTERVAL=1 day

# Ingestion Settings
INGESTION_ENABLED=true
INGESTION_TARGET=clickhouse
INGESTION_BATCH_SIZE=10000
INGESTION_MAX_WORKERS=4
INGESTION_CREATE_TABLES=true

# =============================================================================
# Cloud Storage (AWS S3)
# =============================================================================
CLOUD_CLIENT=aws
CLOUD_PUSH_TO_CLOUD=true
CLOUD_STORAGE_NAME=marketdata-pipeline
CLOUD_DESTINATION_FOLDER=market_data_storage

# AWS Credentials (required if CLOUD_PUSH_TO_CLOUD=true and CLOUD_CLIENT=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=  # Optional: for S3-compatible storage (MinIO, etc.)

# Azure Blob Storage (if CLOUD_CLIENT=azure)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=marketdata-pipeline

# Google Cloud Storage (if CLOUD_CLIENT=gcp)
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=marketdata-pipeline
GCP_CREDENTIALS_PATH=  # Path to service account JSON

# =============================================================================
# Broker API Tokens (place in access_token/ directory as JSON files)
# =============================================================================
# upstox.json: {"access_token": "your_token"}
# groww.json: {"access_token": "your_token"}
# dhan.json: {"access_token": "your_token", "token": "your_token"}
# zerodha.json: {"api_key": "your_key", "access_token": "your_token"}

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5